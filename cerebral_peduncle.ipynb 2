    "\n",
    "            logits = model(imgs)\n",
    "            loss = criterion(logits, masks)\n",
    "            val_loss += loss.item()\n",
    "\n",
    "            batch_metrics = compute_metrics(logits, masks)\n",
    "\n",
    "            for key in metric_sums:\n",
    "                metric_sums[key] += batch_metrics[key]\n",
    "\n",
    "    avg_val_loss = val_loss / len(val_loader)\n",
    "\n",
    "    avg_metrics = {\n",
