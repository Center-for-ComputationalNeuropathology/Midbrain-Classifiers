    "        loss.backward()\n",
    "        optimizer.step()\n",
    "\n",
    "        train_loss += loss.item()\n",
    "\n",
    "    avg_train_loss = train_loss / len(train_loader)\n",
    "\n",
    "    model.eval()\n",
    "    val_loss = 0.0\n",
    "\n",
    "    metric_sums = {\n",
    "        \"dice\": 0.0,\n",
    "        \"iou\": 0.0,\n",
    "        \"pixel_acc\": 0.0,\n",
